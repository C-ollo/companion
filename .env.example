# Copy to .env and fill in. Never commit .env.

# AWS region where Bedrock models are enabled (Claude Opus 5.5 is in us-east-1 and us-west-2)
AWS_REGION=us-east-1

# Bedrock model used for logs, Point & Ask, step checks and summaries
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Mobile/web app: base URL of the deployed API (printed by `cdk deploy`)
EXPO_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com
